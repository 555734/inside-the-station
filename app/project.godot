; Umeda Station walkthrough (Godot 4.4)
config_version=5

[application]

config/name="梅田駅ウォークスルー"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://ui/icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

occlusion_culling/use_occlusion_culling=true

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
reflections/reflection_atlas/reflection_size=256
reflections/reflection_atlas/reflection_count=32
anti_aliasing/quality/msaa_3d=1

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true
}
